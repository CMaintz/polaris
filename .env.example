# Copy to .env (never commit .env). All values below are placeholders.

# 32-byte master key, base64. Encrypts stored AI provider keys at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
POLARIS_MASTER_KEY=

# Where the SQLite database lives (default: ./data/polaris.db).
POLARIS_DB_PATH=./data/polaris.db

# HTTP port for the API and the built web app (default: 4480).
POLARIS_PORT=4480

# Set to "true" when served over HTTPS so session cookies get the Secure flag.
POLARIS_SECURE_COOKIES=false

# Bind address. Keep loopback and put a TLS reverse proxy in front for remote access.
POLARIS_HOST=127.0.0.1

# Allow more than the first account to register (default: false).
POLARIS_ALLOW_SIGNUP=false

# Largest accepted import upload in MB (default: 100).
POLARIS_MAX_UPLOAD_MB=100
